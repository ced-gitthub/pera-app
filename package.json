{
 "name": "pera",
 "version": "0.1.0",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "typecheck": "tsc --noEmit",
  "test": "node --experimental-strip-types --test tests/core.test.ts tests/app.test.ts tests/auth.test.ts",
  "test:app": "tsx --tsconfig tests/e2e/tsconfig.json tests/e2e/app.e2e.tsx",
  "test:browser": "node tests/browser/build.cjs && python3 tests/browser/quickadd.py",
  "test:prod": "echo 'Production suites run in GitHub Actions: .github/workflows/prod-qa.yml'"
 },
 "dependencies": {
  "@supabase/ssr": "^0.6.1",
  "@supabase/supabase-js": "^2.50.0",
  "next": "^15.3.0",
  "nodemailer": "^7.0.3",
  "react": "^19.0.0",
  "react-dom": "^19.0.0"
 },
 "devDependencies": {
  "@tailwindcss/postcss": "^4.1.0",
  "@types/node": "^22.0.0",
  "@types/nodemailer": "^6.4.17",
  "@types/react": "^19.0.0",
  "@types/react-dom": "^19.0.0",
  "esbuild": "^0.25.0",
  "postcss": "^8.5.0",
  "tailwindcss": "^4.1.0",
  "tsx": "^4.19.0",
  "typescript": "^5.6.0"
 },
 "overrides": {
  "postcss": "$postcss"
 }
}
