{
 "name": "pera",
 "version": "0.1.0",
 "private": true,
 "scripts": {
  "dev": "next dev",
  "build": "next build",
  "start": "next start",
  "typecheck": "tsc --noEmit",
  "test": "node --experimental-strip-types --test tests/core.test.ts tests/app.test.ts tests/auth.test.ts",
  "test:app": "tsx --tsconfig tests/e2e/tsconfig.json tests/e2e/app.e2e.tsx",
  "test:browser": "node tests/browser/build.cjs && python3 tests/browser/quickadd.py",
  "test:prod": "echo 'Production suites run in GitHub Actions: .github/workflows/prod-qa.yml'",
  "lint": "eslint src tests scripts --max-warnings=285",
  "format": "prettier --write src tests scripts",
  "format:check": "prettier --check src tests scripts",
  "selftest": "node --experimental-strip-types scripts/selftest.mjs",
  "verify": "npm run selftest && npm run typecheck && npm test && npm run lint",
  "prepare": "git config core.hooksPath .githooks || exit 0"
 },
 "dependencies": {
  "@supabase/ssr": "^0.12.7",
  "@supabase/supabase-js": "^2.50.0",
  "next": "^15.3.0",
  "nodemailer": "^10.0.16",
  "react": "^19.0.0",
  "react-dom": "^19.0.0"
 },
 "devDependencies": {
  "@eslint/js": "^10.0.1",
  "@tailwindcss/postcss": "^4.1.0",
  "@types/node": "^22.0.0",
  "@types/nodemailer": "^6.4.17",
  "@types/react": "^19.0.0",
  "@types/react-dom": "^19.0.0",
  "esbuild": "^0.28.2",
  "eslint": "^10.12.0",
  "eslint-plugin-react-hooks": "^7.1.1",
  "postcss": "^8.5.0",
  "prettier": "^3.9.10",
  "tailwindcss": "^4.1.0",
  "tsx": "^4.19.0",
  "typescript": "^5.6.0",
  "typescript-eslint": "^8.71.1"
 },
 "overrides": {
  "postcss": "$postcss"
 }
}
